{
  "manifest": {
    "schema_version": 1,
    "id": "network_proxy_monitor",
    "name": "网络代理监控",
    "version": "1.0.0",
    "sdk_version": "2",
    "python_version": "3.11",
    "entry": "plugin.py",
    "class_name": "Plugin",
    "description": "",
    "permissions": [
      "proxy.monitor",
      "proxy.control"
    ],
    "dependencies": [],
    "config_schema": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "title": "类型",
          "enum": [
            "Clash",
            "v2rayA"
          ],
          "default": "Clash"
        },
        "clash_url": {
          "type": "string",
          "title": "地址",
          "default": "",
          "maxLength": 2048
        },
        "clash_secret": {
          "type": "string",
          "title": "API Key",
          "format": "password",
          "default": "",
          "maxLength": 4096
        },
        "v2raya_url": {
          "type": "string",
          "title": "地址",
          "default": "",
          "maxLength": 2048
        },
        "v2raya_token": {
          "type": "string",
          "title": "API Key",
          "format": "password",
          "default": "",
          "maxLength": 4096
        },
        "v2raya_username": {
          "type": "string",
          "title": "用户名",
          "default": "",
          "maxLength": 120
        },
        "v2raya_password": {
          "type": "string",
          "title": "密码",
          "format": "password",
          "default": "",
          "maxLength": 1024
        },
        "timeout": {
          "type": "integer",
          "title": "超时时间 (s)",
          "default": 5,
          "minimum": 1,
          "maximum": 10
        },
        "strategy": {
          "type": "string",
          "title": "模式",
          "enum": [
            "monitor",
            "failover",
            "optimize"
          ],
          "default": "monitor"
        },
        "group": {
          "type": "string",
          "title": "分组",
          "default": "",
          "maxLength": 120
        },
        "probe_url": {
          "type": "string",
          "title": "URL",
          "default": "https://www.gstatic.com/generate_204",
          "maxLength": 2048
        },
        "probe_timeout": {
          "type": "integer",
          "title": "超时时间 (s)",
          "default": 3,
          "minimum": 1,
          "maximum": 10
        },
        "probe_concurrency": {
          "type": "integer",
          "title": "并发数",
          "default": 3,
          "minimum": 1,
          "maximum": 5
        },
        "failure_threshold": {
          "type": "integer",
          "title": "失败次数",
          "default": 2,
          "minimum": 1,
          "maximum": 20
        },
        "failure_window": {
          "type": "integer",
          "title": "时间范围 (s)",
          "default": 300,
          "minimum": 1,
          "maximum": 86400
        },
        "optimize_interval": {
          "type": "integer",
          "title": "刷新间隔 (s)",
          "default": 300,
          "minimum": 1,
          "maximum": 86400
        },
        "cooldown": {
          "type": "integer",
          "title": "间隔 (s)",
          "default": 300,
          "minimum": 0,
          "maximum": 86400
        },
        "min_dwell": {
          "type": "integer",
          "title": "持续时间 (s)",
          "default": 300,
          "minimum": 0,
          "maximum": 86400
        },
        "min_improvement": {
          "type": "integer",
          "title": "延迟 (ms)",
          "default": 50,
          "minimum": 0,
          "maximum": 60000
        },
        "excluded_nodes": {
          "type": "string",
          "title": "排除关键词",
          "default": "",
          "maxLength": 1024
        },
        "domain_rules": {
          "type": "string",
          "title": "规则",
          "default": "",
          "maxLength": 4096
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "schedules": [
      {
        "id": "monitor",
        "cron": "*/30 * * * * *",
        "method": "run"
      }
    ],
    "events": [
      {
        "event": "plugin.started",
        "method": "run"
      },
      {
        "event": "plugin.manual",
        "method": "run"
      }
    ]
  },
  "sha256": "a570b80372a0c2975a60945bd23a93a409972fd3eb16527ea5aa57a2075b65fc",
  "size": 1487,
  "author": "treehello0210",
  "package": "plugins/network_proxy_monitor/1.0.0/plugin.zip"
}
