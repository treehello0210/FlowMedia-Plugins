{
  "manifest": {
    "schema_version": 1,
    "id": "fengchao_signin",
    "name": "蜂巢论坛签到",
    "version": "1.0.0",
    "sdk_version": "2",
    "python_version": "3.11",
    "entry": "plugin.py",
    "class_name": "Plugin",
    "description": "通过专用 API Key 完成蜂巢论坛自动签到、站点数据同步、论坛通知接收及账号状态与签到日历展示。",
    "tags": [
      "论坛签到",
      "蜂巢"
    ],
    "permissions": [
      "forum.fengchao"
    ],
    "dependencies": [],
    "config_schema": {
      "type": "object",
      "properties": {
        "api_key": {
          "type": "string",
          "title": "API Key",
          "format": "password",
          "default": "",
          "maxLength": 512,
          "description": "在论坛「隐秘的角落」生成，后续可在「PT 人生」轮换。"
        },
        "cron": {
          "type": "string",
          "title": "自动签到 Cron",
          "default": "30 8 * * *",
          "maxLength": 100,
          "description": "按 Asia/Shanghai 时区执行；留空暂停自动签到。"
        },
        "notify": {
          "type": "boolean",
          "title": "发送结果通知",
          "default": true
        },
        "use_proxy": {
          "type": "boolean",
          "title": "使用网络代理",
          "default": false,
          "description": "默认直连；开启后使用系统「网络代理」配置。"
        },
        "sync_enabled": {
          "type": "boolean",
          "title": "同步 PT 人生",
          "default": true
        },
        "timed_update_enabled": {
          "type": "boolean",
          "title": "独立定时同步",
          "default": true,
          "description": "关闭后仅在签到时按同步间隔上传站点快照。"
        },
        "timed_update_cron": {
          "type": "string",
          "title": "数据同步 Cron",
          "default": "0 3 * * *",
          "maxLength": 100,
          "description": "按 Asia/Shanghai 时区执行；默认每日 03:00。"
        },
        "sync_interval_days": {
          "type": "integer",
          "title": "同步间隔 (天)",
          "default": 1,
          "minimum": 1,
          "maximum": 7
        },
        "retry_count": {
          "type": "integer",
          "title": "签到重试次数",
          "default": 1,
          "minimum": 0,
          "maximum": 10
        },
        "retry_interval": {
          "type": "integer",
          "title": "签到重试间隔 (小时)",
          "default": 2,
          "minimum": 1,
          "maximum": 24
        },
        "timed_update_retry_count": {
          "type": "integer",
          "title": "同步重试次数",
          "default": 1,
          "minimum": 0,
          "maximum": 10
        },
        "timed_update_retry_interval": {
          "type": "integer",
          "title": "同步重试间隔 (小时)",
          "default": 2,
          "minimum": 1,
          "maximum": 24
        },
        "history_days": {
          "type": "integer",
          "title": "记录保留天数",
          "default": 30,
          "minimum": 1,
          "maximum": 3650
        },
        "webhook_enabled": {
          "type": "boolean",
          "title": "接收论坛通知",
          "default": false,
          "description": "保存后自动校验并同步论坛回调配置。"
        },
        "webhook_public_url": {
          "type": "string",
          "title": "服务公网地址",
          "default": "",
          "maxLength": 512,
          "description": "当前服务的 HTTPS 公网访问地址，域名需具备可用 IPv4 解析。"
        },
        "webhook_secret": {
          "type": "string",
          "title": "回调签名密钥",
          "format": "password",
          "default": "",
          "maxLength": 512,
          "description": "可选，16–512 位字符；留空时自动使用本机持久化密钥派生。"
        },
        "webhook_system_notification": {
          "type": "boolean",
          "title": "系统通知",
          "default": true
        },
        "webhook_reply_notification": {
          "type": "boolean",
          "title": "帖子与评论回复",
          "default": true
        },
        "webhook_private_message": {
          "type": "boolean",
          "title": "私信通知",
          "default": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "schedules": [],
    "events": [
      {
        "event": "plugin.started",
        "method": "run"
      },
      {
        "event": "plugin.manual",
        "method": "run"
      }
    ]
  },
  "sha256": "6c8e42b7e8ee67b346ebeff8d4c638794dee222eec5ba3cca11d97d7eec8c3d3",
  "size": 1883,
  "author": "treehello0210",
  "package": "plugins/fengchao_signin/1.0.0/plugin.zip"
}
